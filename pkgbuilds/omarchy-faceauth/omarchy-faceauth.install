# Installing the package touches nothing in /etc/pam.d: wiring is the opt-in
# `omarchy setup security face`, and `omarchy remove security face` takes the
# PAM services out before dropping the package.

post_install() {
  cat <<'EOT'
omarchy-faceauth is installed. This package does not wire PAM or enable its service.
Installation makes the IR sensor's control node (exposure, gain, strobe)
root-only; the RGB webcam is untouched. The fingerprint D-Bus policy takes
effect system-wide, including for stock pam_fprintd clients. Installation
also creates the root-only key lease file /run/faceauth-key.lease.
  omarchy setup security face     check the camera, add the models, enrol,
                                  verify, then wire PAM
  faceauth doctor                 the state of every part
Setup enables the FaceAuth service after checking and configuring authentication.
EOT
}

# No post_upgrade: a restart from here would run before pacman's
# daemon-reload hook and start the old unit. 90-omarchy-faceauth-restart.hook
# restarts the service after the reload.

pre_remove() {
  # A bare pacman -R under a wired stack leaves every sudo, polkit and
  # lock-screen attempt loading a module that is gone: the password paths
  # still work, but each attempt logs the failure and the lock screen keeps
  # retrying its face lane. The PAM files belong to other packages, so they
  # are not edited from here; the Omarchy removal takes the lines out.
  if grep -qs 'pam_faceauth\.so' /etc/pam.d/*; then
    cat <<'EOT'
/etc/pam.d still names pam_faceauth.so. Run `omarchy remove security face`
to take face authentication out of PAM; until then sudo, polkit and the lock
screen fall to the password after a failed module load on every attempt.
EOT
  fi
  systemctl disable --now faceauth.service 2>/dev/null || true
}
