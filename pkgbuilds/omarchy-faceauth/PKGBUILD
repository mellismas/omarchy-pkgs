# Maintainer: Michael Ellis <mej2200@gmail.com>
# Model weights are not in the package: the manifest is, and
# `faceauth models fetch` downloads and verifies them at setup.

pkgname=omarchy-faceauth
pkgver=0.1.0
pkgrel=1
pkgdesc='Face authentication for Omarchy: IR camera, liveness gate, daemon, PAM module'
url='https://github.com/mellismas/omarchy-faceauth'
arch=(x86_64)
license=(MIT)
depends=(
  onnxruntime-cpu   # loaded at run time from /usr/lib/libonnxruntime.so
  pam
  curl              # faceauth models fetch
  coreutils         # sha256sum
  systemd
)
makedepends=(rust cargo)
# Concurrent IR+RGB capture and the illuminator control on IPU3 machines need
# the two patches shipped in linux-omarchy (0543, 0544); everything else works
# on a stock kernel with a UVC IR camera.
optdepends=('linux-omarchy: concurrent IR+RGB capture and the IR illuminator on Intel IPU3 laptops')
backup=(etc/faceauth/config.toml)
install=omarchy-faceauth.install
source=("$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('1a452cb4ae2e81db34ddd8e727ab30f51e669a0704e56deb01a766db4a3ec297')

build() {
  cd "$srcdir/$pkgname-$pkgver"
  export CARGO_TARGET_DIR=target
  cargo build --release --locked
}

check() {
  cd "$srcdir/$pkgname-$pkgver"
  cargo test --release --locked
}

package() {
  cd "$srcdir/$pkgname-$pkgver"
  install -Dm755 target/release/faceauthd "$pkgdir/usr/bin/faceauthd"
  install -Dm755 target/release/faceauth "$pkgdir/usr/bin/faceauth"
  install -Dm755 packaging/faceauth-lock-session "$pkgdir/usr/bin/faceauth-lock-session"
  install -Dm755 target/release/libpam_faceauth.so "$pkgdir/usr/lib/security/pam_faceauth.so"
  install -Dm644 packaging/faceauth.service "$pkgdir/usr/lib/systemd/system/faceauth.service"
  install -Dm644 packaging/config.toml "$pkgdir/etc/faceauth/config.toml"
  install -Dm644 models.toml "$pkgdir/usr/share/faceauth/models.toml"
  install -dm755 "$pkgdir/usr/share/faceauth/models"
  install -dm700 "$pkgdir/var/lib/faceauth"
  install -Dm644 packaging/pam-example.txt "$pkgdir/usr/share/doc/$pkgname/pam-example.txt"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
