# Maintainer: Michael Ellis <mej2200@gmail.com>

pkgname=omarchy-faceauth
pkgver=0.1.2
pkgrel=1
pkgdesc='Face authentication for Omarchy with the IR camera: daemon, PAM module and CLI'
arch=('x86_64')
url='https://github.com/mellismas/omarchy-faceauth'
license=('MIT')
install='omarchy-faceauth.install'
options=('!debug')
# The models are their own package (arch=any, pacman-owned, checksummed), and
# an optional one: `omarchy setup security face` installs this package first,
# runs `faceauth doctor` on the camera and the kernel, and installs the 260 MB
# of models only once that check passes, so a laptop that cannot work never
# downloads them. The daemon refuses to start without them.
# libonnxruntime.so is loaded at run time from /usr/lib; every Arch build of
# onnxruntime (cpu, cuda, rocm, opt-*) provides it and the ort crate needs
# API 17 or newer, so the provide is depended on, not one variant, which the
# GPU builds conflict with. coreutils supplies sha256sum for `faceauth
# doctor`; systemd-creds and tpm2-tss seal the templates to the TPM; acl opens
# the daemon's socket to the enrolled users.
depends=(
  'onnxruntime>=1.17'
  'pam'
  'coreutils'
  'systemd>=248'
  'pam-u2f'
  'tpm2-tss'
  'acl'
  'gcc-libs'
  'glibc'
)
makedepends=('cargo')
optdepends=('fprintd: fingerprint authentication through the private PAM helper'
            'omarchy-faceauth-models: the models the daemon runs; omarchy setup security face installs them once the camera check passes'
            'curl: faceauth models fetch, a developer command that downloads the manifest'"'"'s files into a directory of your choosing')
# Hardware requirement, not expressible as a dependency: the daemon drives an
# ov7251 IR sensor on Intel's IPU3 graph and needs the kernel to expose its
# illuminator as a V4L2 strobe control. The stock ov7251 driver, and so every
# shipped linux-omarchy and linux-omarchy-bore, lacks that control (the patch is not yet
# upstream); without it the daemon refuses every attempt and
# the password is used, and setup stops before enrolment. UVC IR modules are
# not supported.
backup=('etc/faceauth/config.toml')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz"
        'omarchy-faceauth.hook')
sha256sums=('cdf0dad05ddf88e60413dda8bd9cd83cbd187f4c012acf4d4d5ecefcda8089de'
            '2c4db594dd64148606d363371a8276182704dd4b9b8d4acfb1cba4240cd9876a')

prepare() {
  cd "$srcdir/$pkgname-$pkgver"

  cargo fetch --locked --target "$CARCH-unknown-linux-gnu"
}

build() {
  cd "$srcdir/$pkgname-$pkgver"

  export CARGO_TARGET_DIR=target
  cargo build --frozen --release --workspace
}

check() {
  cd "$srcdir/$pkgname-$pkgver"

  export CARGO_TARGET_DIR=target
  # The sealing test needs a TPM and root, and makepkg never runs as root, so
  # a packaged build cannot test sealing: the store test runs in its plaintext
  # branch here, and a passing check() is not evidence that templates seal.
  # That is left to the supervised end-to-end test as root.
  cargo test --frozen --release --workspace
  # The lock helper is shell; its test stubs systemd-run and needs no session.
  bash tests/lock-session-test.sh
  bash tests/pam-module-test.sh target/release/libpam_faceauth.so
}

package() {
  cd "$srcdir/$pkgname-$pkgver"

  install -Dm755 target/release/faceauthd "$pkgdir/usr/bin/faceauthd"
  install -Dm755 target/release/faceauth "$pkgdir/usr/bin/faceauth"
  install -Dm755 packaging/faceauth-lock-session "$pkgdir/usr/lib/faceauth/faceauth-lock-session"
  # The security key: its sandboxed check, the lock-state helper, and the
  # private PAM stacks faceauth-keycheck reads (one per PIN and UV policy).
  install -Dm755 target/release/faceauth-keycheck "$pkgdir/usr/lib/faceauth/faceauth-keycheck"
  install -Dm755 target/release/faceauth-lockstate "$pkgdir/usr/lib/faceauth/faceauth-lockstate"
  # The fingerprint: its sandboxed check, its private PAM stack, and the bus
  # policy without which it is offered nowhere (docs/DEVELOPMENT.md).
  install -Dm755 target/release/faceauth-fprintcheck "$pkgdir/usr/lib/faceauth/faceauth-fprintcheck"
  install -Dm644 packaging/pam.d/faceauth-fprint -t "$pkgdir/usr/lib/faceauth/pam.d/"
  install -Dm644 packaging/system.d/faceauth-fprint.conf "$pkgdir/usr/share/dbus-1/system.d/faceauth-fprint.conf"
  install -Dm644 -t "$pkgdir/usr/lib/faceauth/pam.d/" packaging/pam.d/faceauth-key packaging/pam.d/faceauth-key-* packaging/pam.d/other
  # The key lease every check holds (/run/faceauth-key.lease).
  install -Dm644 packaging/faceauth.tmpfiles "$pkgdir/usr/lib/tmpfiles.d/faceauth.conf"
  install -Dm755 target/release/libpam_faceauth.so "$pkgdir/usr/lib/security/pam_faceauth.so"
  install -Dm644 packaging/faceauth.service "$pkgdir/usr/lib/systemd/system/faceauth.service"
  # Keeps the IR sensor's control node root-only; the RGB webcam is untouched.
  install -Dm644 packaging/72-faceauth-ir.rules "$pkgdir/usr/lib/udev/rules.d/72-faceauth-ir.rules"
  # Restarts the daemon after an upgrade, once pacman has reloaded the units.
  install -Dm644 "$srcdir/omarchy-faceauth.hook" "$pkgdir/usr/share/libalpm/hooks/90-omarchy-faceauth-restart.hook"
  install -Dm644 packaging/config.toml "$pkgdir/etc/faceauth/config.toml"
  # The manifest names the models with their checksums, sizes and licences;
  # `faceauth doctor` verifies the files omarchy-faceauth-models installed
  # under /usr/share/faceauth/models against it.
  install -Dm644 models.toml "$pkgdir/usr/share/faceauth/models.toml"
  install -dm700 "$pkgdir/var/lib/faceauth"
  install -Dm644 packaging/pam-example.txt "$pkgdir/usr/share/doc/$pkgname/pam-example.txt"
  install -Dm644 docs/SECURITY.md "$pkgdir/usr/share/doc/$pkgname/SECURITY.md"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
